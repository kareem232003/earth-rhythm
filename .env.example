# ============================================================================
# 1. NASA Earthdata Login Credentials (Used by Phase 1 NISAR HDF5 Extraction)
# Register for free at: https://urs.earthdata.nasa.gov/
# ============================================================================
EARTHDATA_USERNAME=your_earthdata_username_here
EARTHDATA_PASSWORD=your_earthdata_password_here

# ============================================================================
# 2. Echo AI Helper — Multi-Provider Configuration (Optional in .env)
# You only need ONE provider below (or you can paste your key directly inside
# the website's "Ask Echo -> API Key" button without touching this file!).
# ============================================================================

# Default provider to select on startup (gemini | groq | openrouter | openai | anthropic | deepseek | mistral | ollama)
ECHO_DEFAULT_PROVIDER=gemini

# [1] Google Gemini (Recommended — FREE Tier via Google AI Studio)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# [2] Groq Cloud (Recommended — FREE Tier & Ultra-Fast LPU)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# [3] OpenRouter (Supports 200+ Free & Paid Models)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# [4] OpenAI (ChatGPT: gpt-4o-mini / gpt-4o)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [5] Anthropic (Claude: claude-3-5-haiku-latest / claude-3-7-sonnet-latest)
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# [6] DeepSeek (deepseek-chat / deepseek-reasoner)
# Get a key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# [7] Mistral AI (mistral-small-latest / open-mixtral-8x7b)
# Get a key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# [8] Local Ollama (100% Offline, No API Key Required)
# Download at: https://ollama.com/download (then run: ollama run llama3.2)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2



